<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_perception</name>
  <version>0.0.0</version>
  <description>L4 perception home (gesture_detector lands here): speed band publisher for the runtime speed limiter (ADR-0012).</description>
  <maintainer email="ryu3124ruyu@gmail.com">kawaguchiryuya</maintainer>
  <license>Apache-2.0</license>

  <!-- Frozen contract only (MAX_LINEAR_VELOCITY). No other track's internals. -->
  <exec_depend>warehouse_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <!-- 07_Output_Adapters terrain_publisher: sensor_msgs/{Image, CameraInfo,
       LaserScan} (docs/mode-outdoor/04 追補 ⑨). warehouse_description supplies
       the frozen BASE_FRAME name (a read-only shared asset, doc16 §9). -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>warehouse_description</exec_depend>

  <!-- Offline evaluation harness (10_Evaluation, docs/mode-outdoor/04 追補 ⑦):
       eval_sdk is the domain-free evaluation core the warehouse packages depend on
       one-way (same pattern as warehouse_orchestrator / warehouse_llm_bridge);
       python3-yaml parses the model manifests. Neither is used by any node. -->
  <exec_depend>eval_sdk</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
