<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_web_bridge</name>
  <version>0.0.0</version>
  <description>Web Observability gateway (observe-only, doc22): subscribes existing display topics and fans them out to a browser over WebSocket/REST. S1 = rclpy/FastAPI-free offline core (ObsEvent + events.jsonl); S2 = rclpy node + FastAPI.</description>
  <maintainer email="ryu3124ruyu@gmail.com">kawaguchiryuya</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>warehouse_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- eval_sdk: the deterministic trace-seed / trace-id derivation shared with the LLM Bridge
       and the orchestrator-scorer (doc22 §7:195; same one-way exec_depend those two declare).
       langfuse itself stays an optional pip extra — absent, trace_id degrades to null. -->
  <exec_depend>eval_sdk</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
